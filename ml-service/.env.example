# Copy to .env on the server and fill in (the .env file is never committed)
GROQ_API_KEY=
GEMINI_API_KEY=

# Local testing only: lets a phone on the same Wi-Fi/hotspot reach the services.
# Leave it out on the server (default 127.0.0.1 = only Nginx/IIS can reach them).
# BIND_IP=0.0.0.0

# Cloudinary (photos, clips)
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET_KEY=

# Where the Node API runs, when it is not on this server (e.g. https://memocare-api.onrender.com)
# NODE_API_URL=

# Read-only access to the team's MongoDB for the memory progress report (same value as the backend)
MONGO_URI=
