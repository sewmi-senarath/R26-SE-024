<?xml version="1.0" encoding="UTF-8"?>
<!-- IIS site config for the MemoCare server (Windows). Needs the IIS "URL Rewrite"
     and "Application Request Routing" (ARR) modules, with ARR proxy enabled.
     Copy to C:\inetpub\wwwroot\web.config. One public door (80/443), split by path:
       /ai/        -> memory-service  127.0.0.1:8000
       /caregiver/ -> caregiver model 127.0.0.1:5001
       /dementia/  -> dementia model  127.0.0.1:5002
       /api/       -> Node API        127.0.0.1:5000                              -->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="memory-service" stopProcessing="true">
          <match url="^ai/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8000/{R:1}" />
        </rule>
        <rule name="caregiver" stopProcessing="true">
          <match url="^caregiver/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:5001/{R:1}" />
        </rule>
        <rule name="dementia" stopProcessing="true">
          <match url="^dementia/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:5002/{R:1}" />
        </rule>
        <rule name="node-api" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:5000/api/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering>
        <!-- photos, audio clips and family enrolment uploads: up to 25 MB -->
        <requestLimits maxAllowedContentLength="26214400" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
