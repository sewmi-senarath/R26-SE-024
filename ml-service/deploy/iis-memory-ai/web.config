<?xml version="1.0" encoding="UTF-8"?>
<!-- IIS site for the MemoCare memory AI service on a Windows server that already hosts
     other sites. This is its OWN site (bound to its own host name, e.g.
     memocare-ai.duckdns.org), so the other sites are not touched.
     Needs the IIS "URL Rewrite" and "Application Request Routing" modules with ARR proxy
     enabled. Copy this file into the site's empty folder (e.g. C:\memocare-site).
     Every request goes to the memory service at 127.0.0.1:8000 (an NSSM Windows service). -->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="memory-service" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8000/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering>
        <!-- photos, audio clips and family enrolment uploads: up to 25 MB -->
        <requestLimits maxAllowedContentLength="26214400" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
